;
; BIND data file for the local loopback interface
;
$TTL    604800
@       IN      SOA     ns1.myorg.net. admin.myorg.net. (
                              2         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL

;

; NS records for name servers
        IN      NS      ns1.myorg.net.
        IN      NS      ns2.myorg.net.

; A records for name servers
ns1.myorg.net.          IN      A       xxx.xxx.xxx.xxx
ns2.myorg.net.          IN      A       xxx.xxx.xxx.xxx

; Mail handler or MX record for the domain hwdomain.io
myorg.net.    IN     MX   10   xxxxxxxxxxxxxx

; A records for domain names
myorg.net.              IN      A      xxx.xxx.xxx.xxx
mail.myorg.net.         IN      A      xxx.xxx.xxx.xxx
ns1.myorg.net.          IN      A      xxx.xxx.xxx.xxx
ns2.myorg.net.          IN      A      xxx.xxx.xxx.xxx
www1.myorg.net.         IN      A      xxx.xxx.xxx.xxx
www2.myorg.net.         IN      A      xxx.xxx.xxx.xxx
www3.myorg.net.         IN      A      xxx.xxx.xxx.xxx
www4.myorg.net.         IN      A      xxx.xxx.xxx.xxx
